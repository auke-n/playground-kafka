#!/bin/bash
set -euxo pipefail

dnf install -y docker git
install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v5.5.0/docker-compose-linux-aarch64" -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
curl -fsSL "https://github.com/docker/buildx/releases/download/v0.37.1/buildx-v0.37.1.linux-arm64" -o /usr/local/lib/docker/cli-plugins/docker-buildx
echo "e5cc9fe3bbff5cbc91230981f7860e06076110730a2db997082652199042a1f2  /usr/local/lib/docker/cli-plugins/docker-buildx" | sha256sum --check
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-buildx
docker compose version
docker buildx version
systemctl enable --now docker

git clone --branch "${repository_ref}" --depth 1 "${repository_url}" /opt/kafka-learning-lab
cd /opt/kafka-learning-lab
cp platform/compose/.env.example platform/compose/.env
cat >> platform/compose/.env <<'EOF'
HTTP_HOST_BIND_ADDRESS=0.0.0.0
KAFKA_HOST_BIND_ADDRESS=127.0.0.1
EOF

docker compose --file platform/compose/docker-compose.yml up --detach --build
